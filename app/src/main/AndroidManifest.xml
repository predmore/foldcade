<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Package visibility for the bundled players. Each plugin owns its ids. -->
    <!-- Launcher visibility uses the same MAIN / LAUNCHER filter as queryIntentActivities. -->
    <queries>
        <package android:name="org.azahar_emu.azahar" />
        <package android:name="io.github.lime3ds.android" />
        <package android:name="me.magnum.melonds" />
        <package android:name="me.magnum.melonds.nightly" />
        <package android:name="app.gamenative" />
        <package android:name="app.gamenative.gold" />
        <package android:name="com.limelight" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".FoldcadeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Foldcade"
        android:networkSecurityConfig="@xml/network_security_config"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <activity
            android:name=".PrimaryHomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="app.foldcade.primary">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CompanionHomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="app.foldcade.companion">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".StandInActivity"
            android:exported="false"
            android:launchMode="standard"
            android:taskAffinity="app.foldcade.standin" />

        <activity
            android:name=".LicensesActivity"
            android:exported="false"
            android:launchMode="standard" />
    </application>
</manifest>
