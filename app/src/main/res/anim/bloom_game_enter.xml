<?xml version="1.0" encoding="utf-8"?>
<!--
    A game's window opening over its launch art. It fades in over the art that already
    fills its screen, rather than Android's slide. Window transitions cannot read theme
    tokens, so these are fixed: a short wait while the art finishes growing, then a fade.
-->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromAlpha="0.0"
    android:toAlpha="1.0"
    android:startOffset="80"
    android:duration="240"
    android:interpolator="@android:interpolator/decelerate_quad" />
