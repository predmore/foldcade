<?xml version="1.0" encoding="utf-8"?>
<!-- RomM downloads under cacheDir/romm, and RomM saves under filesDir/romm.
     URIs are content://<authority>/romm/<path under the cache root> or
     content://<authority>/romm-data/<path under the data root>, the same mapping as CachePathContentUri. -->
<paths>
    <cache-path name="romm" path="romm/" />
    <files-path name="romm-data" path="romm/" />
</paths>
