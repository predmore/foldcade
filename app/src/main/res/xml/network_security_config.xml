<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext stays off for every host. This file is baked into the APK.
    Android has no API to add the RomM host the user types during setup, so
    that host cannot be allow-listed here. Setup still shows the cleartext
    warning whenever the URL is http.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
