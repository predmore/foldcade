<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- allowBackup=false still blocks cloud backup, not device-to-device transfer. These excludes cover transfer. A new device signs in again. -->
    <exclude domain="file" path="datastore/foldcade_credentials.preferences_pb" />
    <exclude domain="file" path="datastore" />
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
