<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- allowBackup=false still blocks cloud backup. It does not block device-to-device transfer, which is why these excludes are here. -->
        <exclude domain="file" path="datastore/foldcade_credentials.preferences_pb" />
        <exclude domain="file" path="datastore" />
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/foldcade_credentials.preferences_pb" />
        <exclude domain="file" path="datastore" />
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
