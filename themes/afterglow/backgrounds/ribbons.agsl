// SPDX-License-Identifier: MIT
// Afterglow scene shader. All uniforms are bound by the scene manifest.
uniform float2 size;
// Per strand: center, sweep, and wave as fractions of the height, then wave cycles across the panel.
uniform float4 shape[3];
// Per strand: sweep phase, wave phase, pulse, then sweep cycles across the panel.
// Phases and pulse arrive wrapped to one cycle, so they stay exact however long the clock runs.
// Each strand drifts on its own clock, so the strands slide across one another.
uniform float4 drift[3];
uniform float4 start[9];
uniform float4 end[9];
uniform float4 swell;
uniform float reach;
uniform float4 falloff;
uniform float endFade;
uniform float crossingRadius;
// How far the grid has slid, in panel widths. The strands, their swells and their knots
// lie along the world, so they slide with the grid as if the camera moved. The fade at
// either edge and the colour across the panel stay put, as the lens's.
uniform float slide;

const float PI = 3.14159265;
const float TWO_PI = 6.28318531;

float ease(float v) {
    float t = clamp(v, 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

float cover(float t) {
    if (t >= 1.0) return 0.0;
    float bell = exp(-falloff.x * t * t);
    if (t <= falloff.y) return bell;
    return bell * (1.0 - ease((t - falloff.y) / (1.0 - falloff.y)));
}

float knot(float along, float phase) {
    float direct = abs(fract(along) - fract(phase));
    float distance = min(direct, 1.0 - direct);
    if (distance >= falloff.w) return 0.0;
    return 0.5 * (1.0 + cos(distance / falloff.w * PI));
}

float edgeFade(float t) {
    return t < endFade ? ease(t / endFade) : (t > 1.0 - endFade ? ease((1.0 - t) / endFade) : 1.0);
}

// [edge] and [swelling] depend only on where the pixel is across, so main computes them once for every strand.
float ribbonGain(float u, float edge, float swelling, float pulse) {
    if (edge <= 0.0) return 0.0;
    float spots = knot(u, pulse) * 0.9 + knot(u, pulse + 0.46) * 0.5;
    return clamp(edge * (swelling * 0.58 + spots), 0.0, 1.0);
}

half4 main(float2 p) {
    // t is across the screen, u across the world the grid slides over.
    float t = clamp(p.x / size.x, 0.0, 1.0);
    float u = p.x / size.x + slide;
    float edge = edgeFade(t);
    float swelling = 0.34 + 0.66 * (0.5 + 0.5 * sin(TWO_PI * (u * 2.15 + 0.35)));
    // Light adds, so halo, glow, and core blend into one smooth profile and overlaps
    // brighten without the creases a max blend leaves.
    float3 lit = float3(0.0);
    float ys[3];
    float slopes[3];
    for (int i = 0; i < 3; i++) {
        float4 form = shape[i];
        float4 move = drift[i];
        float a = TWO_PI * u * move.w + move.x;
        float b = TWO_PI * u * form.w + move.y;
        float y = (form.x + form.y * sin(a) + form.z * sin(b)) * size.y;
        float slope = (form.y * move.w * cos(a) + form.z * form.w * cos(b)) * TWO_PI * size.y / size.x;
        ys[i] = y;
        slopes[i] = slope;
        float distance = abs(p.y - y) * inversesqrt(1.0 + slope * slope);
        // Most pixels are past even the widest halo; skip the gain curve for them.
        if (distance >= start[i * 3].w * 1.2 * falloff.z) continue;
        float gain = ribbonGain(u, edge, swelling, move.z);
        if (gain <= 0.0) continue;
        float width = 0.28 + 0.92 * gain;
        for (int layer = 0; layer < 3; layer++) {
            float4 left = start[i * 3 + layer];
            float reachPx = left.w * width * falloff.z;
            if (reachPx < 0.5 || distance >= reachPx) continue;
            float3 color = mix(left.rgb, end[i * 3 + layer].rgb, t) * gain;
            lit += color * cover(distance / reachPx);
        }
    }
    if (swell.w > 0.0) {
        float reachPx = crossingRadius * falloff.z;
        for (int left = 0; left < 2; left++) {
            for (int right = 1; right < 3; right++) {
                if (right <= left) continue;
                float gain = edge * (1.0 - ease(abs(ys[left] - ys[right]) / reach));
                if (gain <= 0.0) continue;
                float mid = (ys[left] + ys[right]) * 0.5;
                float slope = (slopes[left] + slopes[right]) * 0.5;
                float distance = abs(p.y - mid) * inversesqrt(1.0 + slope * slope);
                if (distance >= reachPx) continue;
                lit += swell.rgb * gain * cover(distance / reachPx);
            }
        }
    }
    // Untouched pixels stay true black, without the shoulder or dither.
    if (max(lit.r, max(lit.g, lit.b)) <= 0.0) return half4(0.0, 0.0, 0.0, 1.0);
    // A soft shoulder keeps stacked light from clipping.
    lit = 1.0 - exp(-lit);
    // Dim gradients band in 8 bits. Half a level of noise hides the steps.
    float noise = fract(52.9829189 * fract(dot(p, float2(0.06711056, 0.00583715))));
    lit = max(lit + (noise - 0.5) / 255.0, 0.0);
    return half4(half3(lit), 1.0);
}
