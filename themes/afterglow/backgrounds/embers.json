{
  "version": 1,
  "id": "embers",
  "name": "Embers",
  "frameRate": "clamp(30*clock,20,60)",
  "maxClock": 1.25,
  "renderScale": 1,
  "variables": {
    "pace": "time + 3600*seed",
    "breath": "if(moving,1+0.08*sin(2*pi*pace/48),1)",
    "slide": "scroll/width",
    "lift": "sin(2*pi*pace/84)*8",
    "cycle": "66+(index % 4)*6",
    "rise": "fract(pace/cycle+index*0.137)",
    "edge": "if(rise < 0.12,smooth(rise/0.12),if(rise > 0.88,smooth((1-rise)/0.12),1))"
  },
  "layers": [
    {
      "name": "horizon",
      "type": "line",
      "repeat": 5,
      "x": 0,
      "y": "height-8-index*5.2+lift",
      "endX": "width",
      "endY": "height-8-index*5.2+lift",
      "width": 6.2,
      "color": [
        "floor(32*breath*(5-index)/5*0.5)/255",
        "floor(14*breath*(5-index)/5*0.5)/255",
        "floor(26*breath*(5-index)/5*0.5)/255",
        1
      ]
    },
    {
      "name": "embers",
      "type": "disc",
      "repeat": 12,
      "x": "(fract((0.11+(index*73 % 88)/100-slide)/1.1)*1.1-0.05)*width+sin(2*pi*pace/96+index)*14",
      "y": "height+10-rise*(height+20)",
      "radius": 3.565,
      "tightness": 2.2,
      "rim": 0.48,
      "color": [
        "floor(if(index % 2 == 0,140,108)*breath*edge)/255",
        "floor(if(index % 2 == 0,76,82)*breath*edge)/255",
        "floor(if(index % 2 == 0,42,142)*breath*edge)/255",
        1
      ]
    }
  ]
}
