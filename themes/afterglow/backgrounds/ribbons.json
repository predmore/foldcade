{
  "version": 1,
  "id": "ribbons",
  "name": "Ribbons",
  "frameRate": "clamp(if(loop >= 0.4, if(loop <= 8.4, 60, 30), 30)*clock, 20, 60)",
  "maxClock": 1.25,
  "renderScale": 1,
  "animateWhenMotionOff": false,
  "variables": {
    "travel": "time / 90",
    "breath": "if(moving, 1 + 0.08 * sin(2 * pi * time / 48), 1)",
    "loop": "time % 22",
    "turn": "floor(time / 22)",
    "strand": "turn % 3",
    "anchor": "if(strand == 0, 0.40, if(strand == 1, 0.62, 0.33))",
    "sweep": "if(strand == 0, 0.20, if(strand == 1, 0.15, 0.17))",
    "wave": "if(strand == 0, 0.030, if(strand == 1, 0.026, 0.024))",
    "waves": "if(strand == 2, 3, 2)",
    "phase": "if(strand == 0, 0.6, if(strand == 1, 2.5, 4.3))",
    "beadFade": "if(moving, window(loop, 0.4, 8, 2.5), 0)",
    "shimmerFade": "if(moving, window(loop, 6.8, 7, 2.5), 0)"
  },
  "layers": [
    {
      "name": "ribbons and crossings",
      "type": "shader",
      "file": "backgrounds/ribbons.agsl",
      "blend": "lighten",
      "uniforms": {
        "size": [
          "width",
          "height"
        ],
        "travel": "travel",
        "shape": [
          0.4,
          0.2,
          0.03,
          2,
          0.62,
          0.15,
          0.026,
          2,
          0.33,
          0.17,
          0.024,
          3
        ],
        "drift": [
          0.6,
          "0.04*sin(2*pi*travel+0.6)",
          "if(moving,time/36+0*0.33,0.2+0*0.17)",
          0,
          2.5,
          "0.04*sin(2*pi*travel+2.5)",
          "if(moving,time/36+1*0.33,0.2+1*0.17)",
          0,
          4.3,
          "0.04*sin(2*pi*travel+4.3)",
          "if(moving,time/36+2*0.33,0.2+2*0.17)",
          0
        ],
        "start": [
          "14*breath/255",
          "36*breath/255",
          "34*breath/255",
          15,
          "20*breath/255",
          "52*breath/255",
          "48*breath/255",
          6.4,
          "28*breath/255",
          "70*breath/255",
          "66*breath/255",
          2.5,
          "36*breath/255",
          "20*breath/255",
          "10*breath/255",
          14,
          "52*breath/255",
          "30*breath/255",
          "14*breath/255",
          6,
          "72*breath/255",
          "44*breath/255",
          "20*breath/255",
          2.5,
          "14*breath/255",
          "36*breath/255",
          "34*breath/255",
          15,
          "20*breath/255",
          "52*breath/255",
          "48*breath/255",
          6.4,
          "28*breath/255",
          "70*breath/255",
          "66*breath/255",
          2.5
        ],
        "end": [
          "12*breath/255",
          "22*breath/255",
          "40*breath/255",
          0,
          "16*breath/255",
          "32*breath/255",
          "58*breath/255",
          0,
          "22*breath/255",
          "40*breath/255",
          "78*breath/255",
          0,
          "34*breath/255",
          "14*breath/255",
          "20*breath/255",
          0,
          "50*breath/255",
          "20*breath/255",
          "28*breath/255",
          0,
          "70*breath/255",
          "28*breath/255",
          "40*breath/255",
          0,
          "12*breath/255",
          "22*breath/255",
          "40*breath/255",
          0,
          "16*breath/255",
          "32*breath/255",
          "58*breath/255",
          0,
          "22*breath/255",
          "40*breath/255",
          "78*breath/255",
          0
        ],
        "swell": [
          "44*breath/255",
          "52*breath/255",
          "40*breath/255",
          "moving"
        ],
        "reach": "height*0.09",
        "falloff": [
          5.6,
          0.55,
          1.36,
          0.14
        ],
        "endFade": 0.16,
        "crossingRadius": 30
      }
    },
    {
      "name": "traveling bead",
      "type": "disc",
      "radius": 34.1,
      "tightness": 2.2,
      "rim": 0.48,
      "path": {
        "samples": 48,
        "x": "width*u",
        "y": "height*(anchor + sweep*sin(2*pi*(u+travel)+phase) + wave*sin(2*pi*(u+travel)*waves+phase*1.7) + 0.04*sin(2*pi*travel+phase))"
      },
      "along": "clamp((loop-0.4)/8,0,1)",
      "color": [
        "floor(if(strand == 1,168,78)*breath*beadFade)/255",
        "floor(if(strand == 1,118,168)*breath*beadFade)/255",
        "floor(if(strand == 1,52,154)*breath*beadFade)/255",
        "if(beadFade > 0, 1, 0)"
      ]
    },
    {
      "name": "shimmer",
      "type": "disc",
      "x": "(0.08+hash(turn,17)*0.84)*width",
      "y": "(0.08+hash(turn,29)*0.84)*height",
      "radius": 43.4,
      "tightness": 2.2,
      "rim": 0.48,
      "color": [
        "floor(34*breath*shimmerFade*0.85)/255",
        "floor(38*breath*shimmerFade*0.85)/255",
        "floor(36*breath*shimmerFade*0.85)/255",
        "if(shimmerFade > 0,1,0)"
      ]
    }
  ]
}
