{
  "version": 1,
  "id": "ribbons",
  "name": "Ribbons",
  "frameRate": "clamp(if(loop >= 0.4, if(loop <= 8.4, 60, 30), 30)*clock, 20, 60)",
  "maxClock": 1.25,
  "renderScale": 1,
  "animateWhenMotionOff": false,
  "variables": {
    "pace": "time",
    "breath": "if(moving, 1 + 0.08 * sin(2 * pi * time / 48), 1)",
    "center0": "0.4 + 0.07*sin(2*pi*fract(pace/73) + 0.6)",
    "sweep0": "0.19 + 0.045*sin(2*pi*fract(pace/56) + 0.78)",
    "flow0": "2*pi*fract(pace/100) + 0.6",
    "ripple0": "2*pi*fract(pace/-44) + 1.02",
    "center1": "0.62 + 0.08*sin(2*pi*fract(pace/88) + 2.5)",
    "sweep1": "0.15 + 0.04*sin(2*pi*fract(pace/64) + 3.25)",
    "flow1": "2*pi*fract(pace/-121) + 2.5",
    "ripple1": "2*pi*fract(pace/52) + 4.25",
    "center2": "0.33 + 0.06*sin(2*pi*fract(pace/107) + 4.3)",
    "sweep2": "0.17 + 0.035*sin(2*pi*fract(pace/71) + 5.59)",
    "flow2": "2*pi*fract(pace/80) + 4.3",
    "ripple2": "2*pi*fract(pace/-37) + 7.31",
    "loop": "time % 22",
    "turn": "floor(time / 22)",
    "strand": "turn % 3",
    "beadFade": "if(moving, window(loop, 0.4, 8, 2.5), 0)",
    "shimmerFade": "if(moving, window(loop, 6.8, 7, 2.5), 0)",
    "y0": "center0 + sweep0*sin(2*pi*u*1.0 + flow0) + 0.034*sin(2*pi*u*2.0 + ripple0)",
    "y1": "center1 + sweep1*sin(2*pi*u*0.8 + flow1) + 0.03*sin(2*pi*u*2.4 + ripple1)",
    "y2": "center2 + sweep2*sin(2*pi*u*1.3 + flow2) + 0.026*sin(2*pi*u*3.0 + ripple2)"
  },
  "layers": [
    {
      "name": "ribbons and crossings",
      "type": "shader",
      "file": "backgrounds/ribbons.agsl",
      "blend": "lighten",
      "uniforms": {
        "size": [
          "width",
          "height"
        ],
        "shape": [
          "center0",
          "sweep0",
          0.034,
          2.0,
          "center1",
          "sweep1",
          0.03,
          2.4,
          "center2",
          "sweep2",
          0.026,
          3.0
        ],
        "drift": [
          "flow0",
          "ripple0",
          "if(moving,time/36+0.0,0.2)",
          1.0,
          "flow1",
          "ripple1",
          "if(moving,time/-44+0.33,0.37)",
          0.8,
          "flow2",
          "ripple2",
          "if(moving,time/29+0.66,0.54)",
          1.3
        ],
        "start": [
          "14*breath/255",
          "36*breath/255",
          "34*breath/255",
          24,
          "20*breath/255",
          "52*breath/255",
          "48*breath/255",
          7.5,
          "28*breath/255",
          "70*breath/255",
          "66*breath/255",
          2.8,
          "36*breath/255",
          "20*breath/255",
          "10*breath/255",
          22,
          "52*breath/255",
          "30*breath/255",
          "14*breath/255",
          7,
          "72*breath/255",
          "44*breath/255",
          "20*breath/255",
          2.8,
          "14*breath/255",
          "36*breath/255",
          "34*breath/255",
          24,
          "20*breath/255",
          "52*breath/255",
          "48*breath/255",
          7.5,
          "28*breath/255",
          "70*breath/255",
          "66*breath/255",
          2.8
        ],
        "end": [
          "12*breath/255",
          "22*breath/255",
          "40*breath/255",
          0,
          "16*breath/255",
          "32*breath/255",
          "58*breath/255",
          0,
          "22*breath/255",
          "40*breath/255",
          "78*breath/255",
          0,
          "34*breath/255",
          "14*breath/255",
          "20*breath/255",
          0,
          "50*breath/255",
          "20*breath/255",
          "28*breath/255",
          0,
          "70*breath/255",
          "28*breath/255",
          "40*breath/255",
          0,
          "12*breath/255",
          "22*breath/255",
          "40*breath/255",
          0,
          "16*breath/255",
          "32*breath/255",
          "58*breath/255",
          0,
          "22*breath/255",
          "40*breath/255",
          "78*breath/255",
          0
        ],
        "swell": [
          "44*breath/255",
          "52*breath/255",
          "40*breath/255",
          "moving"
        ],
        "reach": "height*0.05",
        "falloff": [
          5.6,
          0.55,
          1.36,
          0.14
        ],
        "endFade": 0.16,
        "crossingRadius": 30
      }
    },
    {
      "name": "traveling bead",
      "type": "disc",
      "radius": 34.1,
      "tightness": 2.2,
      "rim": 0.48,
      "path": {
        "samples": 48,
        "x": "width*u",
        "y": "height*if(strand == 0, y0, if(strand == 1, y1, y2))"
      },
      "along": "clamp((loop-0.4)/8,0,1)",
      "color": [
        "floor(if(strand == 1,168,78)*breath*beadFade)/255",
        "floor(if(strand == 1,118,168)*breath*beadFade)/255",
        "floor(if(strand == 1,52,154)*breath*beadFade)/255",
        "if(beadFade > 0, 1, 0)"
      ]
    },
    {
      "name": "shimmer",
      "type": "disc",
      "x": "(0.08+hash(turn,17)*0.84)*width",
      "y": "(0.08+hash(turn,29)*0.84)*height",
      "radius": 43.4,
      "tightness": 2.2,
      "rim": 0.48,
      "color": [
        "floor(34*breath*shimmerFade*0.85)/255",
        "floor(38*breath*shimmerFade*0.85)/255",
        "floor(36*breath*shimmerFade*0.85)/255",
        "if(shimmerFade > 0,1,0)"
      ]
    }
  ]
}
